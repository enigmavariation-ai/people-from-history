# Copy this file to .env.local and fill in your project values.
# All keys here are client-safe — Supabase keys are gated by RLS,
# the Turnstile site key is the public half (secret stays in Supabase).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_TURNSTILE_SITE_KEY=0x4xxxxxxxxxxxxxxxxxxxxxx
